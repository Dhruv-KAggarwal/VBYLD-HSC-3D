# Dependencies and build
node_modules/
dist/

# Reconstruction workspaces (tens of GB)
runtime/
output/
tmp/

# Bundled photogrammetry binaries are too large for GitHub (>100 MB)
engines/ffmpeg/
engines/colmap/
engines/openmvs/
engines/*.zip
engines/*.7z
engines/*.rar
engines/*.tgz
engines/*.tar
engines/*.tar.gz

# Footage and engine logs. Input footage is never committed. The turntable
# renders into runtime/ and output/, both already ignored above, so the only
# MP4 that may legitimately be checked in is a small documentation sample.
*.mp4
!docs/*.mp4
*.mov
*.m4v
*.mkv
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
*.local
.env
.env.*

# cuDNN 9 runtime for COLMAP ALIKED/LightGlue (~2 GB, installed by
# `npm run setup:cudnn`)
engines/cudnn/

# Gaussian-splat trainer virtualenv (~3 GB, installed by `npm run setup:splat`)
.venv-splat/

# Retired code kept locally for reference
.attic/

# Claude Code local settings (machine-specific paths)
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc
